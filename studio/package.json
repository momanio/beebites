{
  "name": "beebites-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "typecheck": "tsc --noEmit",
    "categories:migrate": "sanity exec scripts/migrateCategories.ts --with-user-token --",
    "seed": "sanity dataset import seed/menu.ndjson",
    "cors:local": "sanity cors add http://localhost:4000 --no-credentials"
  },
  "overrides": {
    "minimatch@^5.0.0": "5.1.8",
    "minimatch@>=7.0.0 <11.0.1": "11.0.1",
    "adm-zip@<0.6.1": "0.6.1",
    "js-yaml@^3.0.0": "3.15.2",
    "typeid-js": {
      "uuid": "11.1.1"
    }
  },
  "dependencies": {
    "@sanity/ui": "^3.1.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^5.9.0",
    "styled-components": "^6.1.19"
  }
}
