{
  "name": "beebites",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "studio": "npm --prefix studio run dev",
    "studio:build": "npm --prefix studio run build",
    "studio:typecheck": "npm --prefix studio run typecheck",
    "studio:migrate-categories": "npm --prefix studio run categories:migrate --",
    "studio:seed": "npm --prefix studio run seed --",
    "studio:cors": "npm --prefix studio run cors:local",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts",
    "test:browser": "node --experimental-strip-types tests/browser.mjs",
    "seed:generate": "node --experimental-strip-types studio/seed/generate.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@sanity/client": "^7.14.1",
    "@sanity/image-url": "^2.0.3",
    "motion": "^12.34.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "@tailwindcss/vite": "^4.3.1",
    "playwright": "1.60.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
